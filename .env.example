# Copy this file to .env.local and fill in the values.
# Never commit .env.local. Only variables prefixed NEXT_PUBLIC_ reach the browser.

# ---- Site ------------------------------------------------------------------
# Public origin of the site, used for canonical URLs, sitemap and share images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Cloudinary (media) ----------------------------------------------------
# Cloud name is public. API key and secret are server-only (signed uploads).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Supabase (enquiries, farmer sign-ups, newsletter) ---------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security, so it must never be exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
